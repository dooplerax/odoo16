<odoo>
  <data>
    <!-- Inherit from the existing report template -->
    <!-- Hereda el informe original de cotización -->
    <template id="report_saleorder_document_custom" inherit_id="sale.report_saleorder_document">
      <xpath expr="//t[@t-set='address']" position="replace">
        <!-- Bloque vacío para reemplazar 'address' -->
        <t></t>
      </xpath>
      <xpath expr="//div[@id='informations']" position="replace">
        <!-- Bloque vacío para reemplazar el contenido de la sección 'informations' -->
        <div></div>
      </xpath>
      <xpath expr="//h2[@class='mt-4']" position="replace">
        <!-- Bloque vacío para reemplazar el contenido del elemento 'h2' -->
        <div></div>
      </xpath>
      <!-- Sobrescribe el contenido del informe original de cotización -->
      <xpath expr="//div[@class='oe_structure']" position="replace">

        <!-- Verificación para datos del cliente -->
        <t t-if="doc.partner_id">
          <!-- Datos del cliente en tres columnas -->
          <div class="row">
            <div class="col-4">
              <xpath expr="//h2" position="replace">
                <h2 class="mt-4">
                  <t t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Factura # </t>
                  <t t-elif="doc.state in ['draft','sent']">Cotización Nro.: </t>
                  <t t-else="">Pedido # </t>
                  <span t-field="doc.name" />
                </h2>
              </xpath>

              <p class="fw-bold">
                Emitido por:
              </p>
              <p>
                <span t-esc="user.name" />
              </p>
              <p class="fw-bold">
                Dirección:
              </p>
              <p>
                <span t-field="doc.partner_id.street" />
              </p>
              <p class="fw-bold">
                Teléfono cliente:
              </p>
              <p>
                <span t-field="doc.partner_id.phone" />
              </p>
            </div>
            <div class="col-4">
              <p class="fw-bold">
                Cliente:
              </p>
              <p>
                <span t-field="doc.partner_id.name" />
              </p>
              <p class="fw-bold">
                Ciudad:
              </p>
              <p>
                <span t-field="doc.partner_id.city" />
              </p>
              <p class="fw-bold">
                Comercial:
              </p>
              <p>
                <t t-if="doc.partner_id.user_id">
                  <span t-field="doc.partner_id.user_id.name" />
                </t>
                <t t-else="">
                  <span>Comercial no asignado</span>
                </t>
              </p>
            </div>
            <div class="col-4">
              <p class="fw-bold">
                Fecha:
              </p>
              <p>
                <span t-field="doc.date_order" t-options='{"widget": "date"}' />
              </p>
              <p class="fw-bold">
                Nro de identificacion:
              </p>
              <p>
                <t t-if="doc.partner_id.vat">
                  <span t-field="doc.partner_id.vat" />
                </t>
                <t t-elif="doc.partner_id.passport">
                  <span t-field="doc.partner_id.passport" />
                </t>
                <t t-else="">
                  <span>Identificación no disponible</span>
                </t>
              </p>
              <p class="fw-bold">
                Fecha de entrega:
              </p>
              <p>
                <span t-field="doc.validity_date" t-options='{"widget": "date"}' />
              </p>
            </div>
          </div>
        </t>

        <!-- Campo grande para notas de la cotización -->

      </xpath>
      <xpath expr="//div[@t-if='doc.signature']" position="before">

        <div
          class="row">
          <p class="fw-bold">Observaciones:</p>
          <!-- <p t-field="doc.description" /> -->
          <div class="row"
            style="border: 2px solid black; margin-top: 20px;  padding: 15px;padding-top: 25px;"> <!--
          Aumentar el padding a 15px -->
          </div>
        </div>

        <!-- Recuadro para el "Recibido del Cliente" -->
        <div
          class="row">
          <div class="col-6"></div>
          <div class="col-6" style="border: 2px solid black; margin-top: 20px; padding: 10px;">
            <p class="fw-bold">Recibido del Cliente</p>
            <p>He recibido y revisado las cortinas entregadas, la cantidad, tipo y material, así
              como
              soportes, empaque, a mí completa satisfacción:</p>
            <div class="row">
              <div class="col-6">
                <p class="fw-bold">Nombres y apellidos: ………………………………………</p>
                <!-- Colocar el campo correspondiente del cliente aquí -->
              </div>
              <div class="col-6">
                <p class="fw-bold">Firma: ………………………………………</p>
                <!-- Colocar el campo correspondiente de la firma aquí -->
              </div>
            </div>
            <div class="row">
              <div class="col-6">
                <p class="fw-bold">Fecha: ………………………………………</p>
                <!-- Colocar el campo correspondiente de la fecha aquí -->
              </div>
            </div>
            <p class="fw-bold">NOTA: Una vez salida la mercadería del Almacén, no se aceptan
              reclamos
              posteriores.</p>
          </div>
        </div>
        <div
          t-if="doc.signature" class="mt-4 ml64 mr4" name="signature">
          <div class="offset-8">
            <strong>Signature</strong>
          </div>
          <div class="offset-8">
            <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;" />
          </div>
          <div class="offset-8 text-center">
            <p t-field="doc.signed_by" />
          </div>
        </div>
      </xpath>
      <xpath expr="//thead"
        position="replace">
        <thead style="display: table-row-group">
          <tr>
            <th name="th_items" class="text-start">ITEMS</th>
            <th name="th_orden" class="text-start">ORDEN</th>
            <th name="th_descripcion" class="text-start">DESCRIPCIÓN</th>
            <th name="th_material" class="text-start">MATERIAL</th>
            <th name="th_ancho" class="text-start">ANCHO</th>
            <th name="th_alto" class="text-start">ALTO</th>
            <th name="th_mando" class="text-start">MANDO</th>
            <th name="th_cant_m2" class="text-start">CANT. / M2</th>
            <th name="th_valor" class="text-start">VALOR</th>
            <th name="th_subtotal" class="text-start">SUBTOTAL</th>
            <th name="th_ambiente" class="text-start">AMBIENTE</th>
            <th name="th_encj" class="text-start">ENCJ</th>
            <th name="th_mot" class="text-start">MOT</th>
            <th name="th_clnt" class="text-start">CLNT</th>
          </tr>
        </thead>
      </xpath>
      <!-- Reemplaza el contenido dentro del elemento <tbody> -->
      <xpath
        expr="//tbody" position="replace">
        <tbody>
          <tr t-foreach="doc.order_line" t-as="line">
            <td>
              <span t-field="line.sequence" />
            </td>
            <td>
              <span t-field="line.order_id.name" />
            </td>
            <td>
              <span t-field="line.details_id.tipo_cortina" />
            </td>  <!-- Cambio a
            tipo_cortina -->

            <td>
              <span t-field="line.product_id.name" />
            </td>
            <td>
              <t t-if="line.details_id.ancho is not None">
                <span t-esc="line.details_id.ancho" />
              </t>
            </td>  <!--
            Mostrar el ancho si no es None -->
            <td>
              <t t-if="line.details_id.alto is not None">
                <span t-esc="line.details_id.alto" />
              </t>
            </td>  <!-- Mostrar
            el alto si no es None -->
            <td>
              <span t-field="line.details_id.mando" />
            </td>
            <td>
              <t t-if="line.details_id.m2 is not None">
                <span t-esc="line.details_id.m2" />
              </t>
            </td>  <!-- Mostrar
            el m2 si no es None -->
            <td>
              <span t-field="line.price_unit" />
            </td>
            <td>
              <span t-field="line.price_subtotal" />
            </td>
            <td>
              <span t-field="line.details_id.name" />
            </td> <!-- Agregar el campo
            "Ambiente" -->
            <!-- Celdas con información de los campos booleanos como checkboxes deshabilitados -->
            <td>
              <input type="checkbox" t-att-checked="line.details_id.encj" disabled="disabled" />
            </td>
            <td>
              <input type="checkbox" t-att-checked="line.details_id.mot" disabled="disabled" />
            </td>
            <td>
              <input type="checkbox" t-att-checked="line.details_id.clnt" disabled="disabled" />
            </td>
          </tr>
        </tbody>


        <!-- New table -->
        <div class="table-responsive">
          <table class="table table-sm mt-3">
            <thead>
              <tr>
                <th name="th_cantidad" class="text-start">CANTIDAD</th>
                <th name="th_descripcion" class="text-start">DESCRIPCIÓN</th>
                <th name="th_material" class="text-start">MATERIAL</th>
                <th name="th_precio_unitario" class="text-start">PRECIO UNITARIO</th>
                <th name="th_subtotal" class="text-start">SUBTOTAL</th>
                <th name="th_iva" class="text-start">IVA</th>
                <th name="th_total" class="text-start">TOTAL</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="doc.order_line" t-as="line">
                <td>
                  <span t-field="line.quantity_extra" />
                </td>
                <td>
                  <span t-field="line.name_extra" />
                </td>
                <td>
                  <span t-field="line.product_id_extra.name" />
                </td>
                <td>
                  <t t-if="line.price_unit_extra is not None">
                    <span t-esc="line.price_unit_extra" />
                  </t>
                </td>
                <td>
                  <t t-if="line.price_subtotal_extra is not None">
                    <span t-esc="line.price_subtotal_extra" />
                  </t>
                </td>
                <td>
                  <t t-if="line.price_total is not None and line.price_subtotal is not None">
                    <span t-esc="round(line.price_total - line.price_subtotal, 2)" />
                  </t>
                </td>
                <td>
                  <t t-if="line.price_total_extra is not None">
                    <span t-esc="line.price_total_extra" />
                  </t>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </xpath>

    </template>
  </data>
</odoo>
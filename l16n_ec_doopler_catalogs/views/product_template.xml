<odoo>
    <data>
        <!-- Herencias de Vistas -->
        <record id="cproduct_template_inherit_form" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"></field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <!-- Campo class_inherit y campos relacionados ocultos cuando classification es
                False -->
                <xpath expr="//field[@name='purchase_ok']" position="before">
                    <span class="d-inline-block">
                        <field name="classification" />
                        <label for="classification" />
                    </span>
                </xpath>
                <xpath expr="//group/field[@name='product_tooltip']" position="after">
                    <field name="classification" invisible="1" /> <!-- Agregar el campo
                    classification invisible -->
                    <field name="class_inherit"
                        attrs="{'required': [('classification', '=', True)], 'invisible': [('classification', '=', False)]}" />
                    <field name="subclass_inherit"
                        attrs="{'required': [('classification', '=', True)], 'invisible': [('classification', '=', False)]}"
                        domain="[('cl_product_id','=',class_inherit)]" />
                    <field name="fa_class_inherit"
                        attrs="{'required': [('classification', '=', True)], 'invisible': [('classification', '=', False)]}"
                        domain="[('scl_product_id','=',subclass_inherit)]" />
                    <field name="mod_class_inherit"
                        attrs="{'required': [('classification', '=', True)], 'invisible': [('classification', '=', False)]}"
                        domain="[('f_product_id','=',fa_class_inherit)]" />
                    <field name="alternative_code" />
                </xpath>
                <!-- <xpath expr="//group/field[@name='default_code']" position="attributes">
                            <attribute
                name="readonly">1</attribute>
                        </xpath>  -->
            </field>
        </record>
        <record id="cproduct_template_inherit_form_2" model="ir.ui.view">
            <field name="name">product.template.form.inherit.2</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"></field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <span class="d-inline-block">
                    <field name="details_ok" />
                    <label for="details_ok" />
                </span>
            </field>
        </record>
        <record id="cproduct_template_inherit_only_form" model="ir.ui.view">
            <field name="name">product.template.only.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"></field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <xpath expr="//group/field[@name='default_code']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="doopler_product_template_tree_view" model="ir.ui.view">
            <field name="name">product.template.product.tree.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view" />
            <field name="arch" type="xml">
                <field name="categ_id" position="before">
                    <field name="class_inherit" optional="show" string="Clase de producto" />
                    <field name="subclass_inherit" optional="show" string="Subclase de producto" />
                    <field name="fa_class_inherit" optional="show" string="Familia de producto" />
                    <field name="mod_class_inherit" optional="show" string="Modelo de producto" />
                </field>
            </field>
        </record>


        <record id="doopler_product_template_form_view_inherit" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='attribute_id']"
                    position="after">
                    <!-- <field name="attribute_id_readonly" invisible="1" />
                    <field name="classification" invisible="1" /> -->
                    <!-- <field name="product_uom_id" /> -->
                </xpath>
                <xpath expr="//field[@name='value_ids']"
                    position="after">
                    <!-- <field name="attribute_id_readonly" invisible="1" />
                <field name="classification" invisible="1" /> -->
                    <field name="product_uom_id" />
                </xpath>
                <xpath expr="//field[@name='attribute_id']" position="attributes">
                    <!-- <attribute name="attrs">{'invisible': [('attribute_id_readonly', '=',
                    True)] }</attribute>
                    <attribute name="attrs">{'readonly': [('id', '!=', False)] }</attribute> -->
                </xpath>
                <!-- <xpath expr="//field[@name='attribute_line_ids']/tree" position="attributes">
                    <attribute name="create" groups="base.group_user">false</attribute>
                    <attribute name="edit" groups="base.group_user">false</attribute>
                    <attribute name="delete" groups="base.group_user">false</attribute>
                </xpath> -->
            </field>
        </record>
        
    </data>
</odoo>
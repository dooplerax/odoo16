    <record id="cproduct_template_inherit_form_2" model="ir.ui.view">
      <field name="name">product.template.form.inherit.2</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_form_view"></field>
      <field name="priority" eval="8" />
      <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']" position="after" >
                <page name="attributes_telas" string="Atributos Telas" attrs ="{'invisible':[('class_inherit','!=',1)]}">

                  <group>
                    <group>
                      <field name="colorTela" attrs="{'required':[('class_inherit','=',1)]}" />
                      <field name="visilloTela" attrs="{'required':[('class_inherit','=',1)]}"></field>
                      <field name="texturaTela" attrs="{'required':[('class_inherit','=',1)]}"></field>
                      <field name="composicionTela" attrs="{'required':[('class_inherit','=',1)]}"></field>


                    </group>
                    <group>
                      <field name="pesoTela" attrs="{'required':[('class_inherit','=',1)]}"></field>
                      <field name="presentacionTela" attrs="{'required':[('class_inherit','=',1)]}"></field>
                      <field name="anchorolloTela" attrs="{'required':[('class_inherit','=',1)]}">
                      </field>

                      <field name="anchofranjaTela"></field>
                      <field name="aperturaTela" attrs="{'required':[('class_inherit','=',1)]}"></field>
                    </group>
                    <group>
                      <field name="umrollo" string='Unidad de Medida Rollo' attrs="{'required':[('class_inherit','=',1)]}"></field>
                      <field name="umfranja" string='Unidad de Medida Franja' attrs="{'required':[('class_inherit','=',1)]}"></field>

                    </group>
                  </group>

                </page>

                <page name="attributes_perfileria" string="Atributos Perfileria" attrs ="{'invisible':[('class_inherit','!=',6)]}">

                  <group>
                    <group>
                      <field name="colorPerfileria" attrs="{'required':[('class_inherit','=',6)]}"></field>
                      <field name="pestaniaPerfileria" ></field>
                      <field name="ranuraPerfileria" ></field>
                      <field name="medidaRanuraPerfileria" ></field>


                    </group>
                    <group>
                      <field name="longitudPerfileria" attrs="{'required':[('class_inherit','=',6)]}"></field>
                      <field name="diametroPerfileria"></field>
                      <field name="umlongitud" string='Unidad de Medida Longitud' attrs="{'required':[('class_inherit','=',6)]}"></field>
                      <field name="umdiametro" string='Unidad de Medida Diametro' attrs="{'required':[('class_inherit','=',6)]}"></field>

                    </group>

                  </group>

                </page>
                <page name="attributes_accesorios" string="Atributos Accesorios" attrs ="{'invisible':[('class_inherit','!=',5)]}" >

                  <group>
                    <group>
                      <field name="colorAccesorios" attrs="{'required':[('class_inherit','=',5)]}"></field>
                      <field name="mandoAccesorios" ></field>



                    </group>
                    <group>
                      <field name="logoAccesorios"></field>
                      <field name="diametroPerfileria"></field>
                      <field name="umdiametroA" string='Unidad de Medida Diametro' attrs="{'required':[('class_inherit','=',5)]}"></field>

                    </group>
                  </group>


                </page>
            </xpath>
      </field>
    </record>

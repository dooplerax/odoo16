<odoo>
    <data noupdate="1">
        <record model="cproduct.doclass" id="default_telas_class">
            <field name="cl_name">TELAS</field>
            <field name="cl_name_code">TELA</field>
        </record>

        <record model="subproduct.dosubclass" id="default_zebra_subclass">
            <field name="scl_name">ZEBRA</field>
            <field name="scl_name_code">ZEBR</field>
        </record>

        <record model="subproduct.dosubclass" id="default_screen_subclass">
            <field name="scl_name">SCREEN</field>
            <field name="scl_name_code">SCRE</field>
        </record>

        <record model="subproduct.dosubclass" id="default_blackout_subclass">
            <field name="scl_name">BLACKOUT</field>
            <field name="scl_name_code">BLAC</field>
        </record>

        <record model="subproduct.dosubclass" id="default_traslucidas_subclass">
            <field name="scl_name">TRASLUCIDAS</field>
            <field name="scl_name_code">TRAS</field>
        </record>

        <record model="cproduct.doclass" id="default_accesorios_class">
            <field name="cl_name">ACCESORIOS</field>
            <field name="cl_name_code">ACCE</field>
        </record>

        <record model="cproduct.doclass" id="default_perfileria_class">
            <field name="cl_name">PERFILERIA</field>
            <field name="cl_name_code">PERF</field>
        </record>

        <record model="cproduct.doclass" id="default_insumos_class">
            <field name="cl_name">INSUMOS</field>
            <field name="cl_name_code">INSU</field>
        </record>

        <record id="uom_category_gramaje" model="uom.category">
            <field name="name">Gramaje</field>
        </record>

        <record id="uom_gramaje_g_per_m2" model="uom.uom">
            <field name="name">g/m2</field>
            <field name="category_id" ref="uom_category_gramaje" />
            <field name="factor" eval="1.0" />
            <field name="uom_type">reference</field>
            <field name="rounding" eval="0.01" />
        </record>
    </data>
</odoo>
    <record id="view_account_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Añadir el notebook al final del formulario -->
            <xpath expr="//group[@name='group2']" position="after">
                <notebook>
                    <page string="Facturas" attrs="{'invisible': [('partner_id', '=', False)]}">
                        <field name="invoice_ids" attrs="{'readonly': [('state', 'in', ['posted', 'cancel'])]}">
                            <tree string="Facturas" create="false" delete="false" editable="bottom">
                                <field name="name" readonly="True"/>
                                <field name="invoice_date" string="Fecha de factura" readonly="True"/>
                                <field name="invoice_date_due" readonly="True"/>
                                <field name="invoice_origin" readonly="False"/>
                                <field name="amount_untaxed_signed" string="Base Imponible" readonly="True"/>
                                <field name="amount_total_signed" string="Total" readonly="True" sum="Total"/>
                                <field name="saldo" string="Saldo" readonly="True" sum="Total Residual" invisible="0" widget="badge"/>
                                <field name="amount_pay" readonly="False" sum="Valor total"/>
                                <field name="state" invisible="1"/>
                                <field name="payment_state" invisible="0" widget="badge" decoration-danger="payment_state in ('not_paid')"  decoration-warning="payment_state in ('partial')"/>
                                <field name="pagos"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="saldo_favor" widget="badge"/>
            </xpath>
            <xpath expr="//field[@name='saldo_favor']" position="attributes">
                <attribute name="widget">monetary</attribute>
                <attribute name="options">{"prefix": "$ "}</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="mark_payment_checkbox" attrs="{'readonly': [('state', 'in', ['posted', 'cancel'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>
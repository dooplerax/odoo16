    <record id="view_stock_move_line_operation_tree_doopler_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.doopler</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="product_uom_d"/>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="quantity_done_times_factor_inv" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_quotation" model="ir.ui.view">
        <field name="name">custom.quotation.form.view.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="name">action_confirm_custom</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="all_pickings_done" invisible="1"/>
            </xpath>
            <xpath expr="/form/header/button[last()]" position="before">
                <button name="action_open_payment_wizard" string="Abono"
                        class="oe_highlight" type="object"
                        attrs="{
                            'invisible': [
                                '|',
                                ('state', '!=', 'sale'),
                                ('invoice_count', '>', 0)
                            ]
                        }"/>
            </xpath>
            <xpath expr="/form/header/button[last()]" position="before">
                <button name="action_confirm_accredited" string="Confirmar Abono"
                        class="oe_highlight" type="object"
                        attrs="{
                            'invisible': [
                                ('state', '!=', 'accredited')
                            ]
                        }" groups="account.group_account_manager"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,accredited,accredited_confirm,sale</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_sale_custom" model="ir.ui.view">
        <field name="name">sale.order.form.sale.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="attributes">
<!--                <attribute name="groups">sales_team.group_sale_manager</attribute>-->
                <attribute name="attrs">{'invisible': [('state', '!=', 'accredited_confirm')]}</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_delivery']" position="attributes">
                <attribute name="groups">stock.group_stock_user,sales_team.group_sale_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
                <attribute name="attrs">
                    {'invisible': [
                        '|',
                        ('all_pickings_done', '=', False),
                        ('invoice_count', '>', 0),
                    ]}
                </attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ['draft', 'sent', 'sale', 'accredited', 'accredited_confirm']), ('id', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button name="action_quotation_send" string="Send by Email" type="object" states="accredited,accredited_confirm" data-hotkey="g" context="{'validate_analytic': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Vista del popup para opciones de pago -->
    <record id="view_sale_order_payment_form" model="ir.ui.view">
        <field name="name">sale.order.payment.form</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <form string="Payment Options">
                <group>
                    <field name="payment_option" widget="radio"/>
                </group>
                <footer>
                    <button string="Abonar" type="object" name="action_apply_payment" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_quotation_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="decoration-warning">state == 'accredited'</attribute>
                <attribute name="decoration-info">state == 'accredited_confirm'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_payment_form_ec" model="ir.ui.view">
            <field name="model">account.payment</field>
            <field name="name">account.payment.form.ec</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_bank_id']" position="after">
                    <field name="type_journal" invisible="1"/>
                    <field name="payment_number" attrs="{'required':[('type_journal', '!=', 'cash')]}"/>
                </xpath>
            </field>
        </record>

         <record id="view_account_move_payment_form_ec" model="ir.ui.view">
            <field name="model">account.move</field>
            <field name="name">account.move.form.ec</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="payment_number" attrs="{'invisible':[('move_type', 'in', ('in_invoice', 'in_receipt', 'in_refund', 'out_invoice', 'out_refund'))]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
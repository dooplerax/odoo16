<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="attributes_document_number_view_form" model="ir.ui.view">
            <field name="name">Credit Note attribute</field>
            <field name="model">account.move.reversal</field>
            <field name="inherit_id" ref="l10n_latam_invoice_document.view_account_move_reversal"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='l10n_latam_use_documents']" position="after">
                    <field name="l16n_ec_is_internal" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='l10n_latam_document_type_id']" position="attributes">
                    <attribute name="attrs">{'invisible': [('l10n_latam_use_documents', '=', False)],
                                             'required': [('l10n_latam_use_documents', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='l10n_latam_document_number']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|','|',('l10n_latam_use_documents', '=', False), ('l10n_latam_manual_document_number', '=', False), ('l16n_ec_is_internal', '=', True)],
                                             'required': [('l10n_latam_manual_document_number', '=', True), ('l10n_latam_use_documents', '=', True),'|', ('l16n_ec_is_internal', '=', False)]}</attribute>
                </xpath>
            </field>
        </record>

       <record id="invoice_origin_credit_note_view_form" model="ir.ui.view">
            <field name="name">Invoice Origin NC</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='journal_div']" position="after">
                    <field name="l16n_ec_invoice_origin_id" attrs="{'invisible': [('move_type', 'not in', ('out_refund', 'in_refund'))], 'readonly': [('posted_before','=', True)]}"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>